{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aifrontkit.dev/schemas/registry-provenance.json",
  "title": "AIFrontKit detached registry provenance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "algorithm", "keyId", "publicKey", "generatedAt", "artifacts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "algorithm": { "const": "Ed25519" },
    "keyId": { "type": "string", "minLength": 1 },
    "publicKey": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "name", "path", "digest", "signature"],
        "properties": {
          "kind": { "enum": ["catalog", "item"] },
          "name": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+$" },
          "path": { "type": "string", "pattern": "^registry/" },
          "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "sourceDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "signature": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
