{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aifrontkit.dev/schemas/registry-catalog.json",
  "title": "AIFrontKit registry catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "items"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "homepage": { "type": "string" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "title", "description", "targets"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "type": { "enum": ["registry:component", "registry:block"] },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "targets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["framework", "flavor", "manifest"],
              "properties": {
                "framework": { "enum": ["react"] },
                "flavor": { "enum": ["css-modules", "tailwind"] },
                "manifest": { "type": "string", "pattern": "^registry/" }
              }
            }
          }
        }
      }
    }
  }
}
