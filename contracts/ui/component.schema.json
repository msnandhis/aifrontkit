{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aifrontkit.dev/schemas/ui-component-contract.json",
  "title": "AIFrontKit UI component contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "status", "purpose", "anatomy", "states", "variants", "accessibility", "implementations"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": { "enum": ["experimental", "preview", "stable"] },
    "purpose": { "type": "string", "minLength": 20 },
    "anatomy": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "states": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "variants": {
      "type": "object",
      "additionalProperties": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
    },
    "accessibility": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "implementations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["framework", "style", "path"],
        "properties": {
          "framework": { "enum": ["react", "web-component", "angular"] },
          "style": { "enum": ["css-modules", "tailwind", "css"] },
          "path": { "type": "string" }
        }
      }
    }
  }
}
