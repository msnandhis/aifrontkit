{
  "name": "aifrontkit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "node scripts/check-boundaries.mjs",
    "boundaries": "pnpm lint",
    "registry:validate": "node scripts/validate-registry.mjs",
    "registry:test": "node --test scripts/validate-registry.test.mjs",
    "registry:typecheck": "tsc -p registry/tsconfig.json",
    "packages:pack": "node scripts/verify-package-tarballs.mjs",
    "packages:consumer": "node scripts/smoke-packed-consumer.mjs",
    "contracts:validate": "node scripts/validate-ui-contracts.mjs",
    "adoption:validate": "node scripts/validate-adoption-contracts.mjs",
    "adoption:test": "node --test scripts/validate-adoption-contracts.test.mjs",
    "compatibility:upstream": "node scripts/check-upstream-compatibility.mjs",
    "compatibility:verify": "node scripts/verify-upstream-release.mjs",
    "compatibility:test": "node --test scripts/check-upstream-compatibility.test.mjs scripts/verify-upstream-release.test.mjs",
    "docs:validate": "node tooling/docs/validate-docs.mjs",
    "docs:test": "node --test tooling/docs/*.test.mjs",
    "performance:check": "node tooling/performance/check-budgets.mjs",
    "performance:test": "node --test tooling/performance/*.test.mjs",
    "quality:validate": "node tooling/quality/component-quality.mjs",
    "quality:test": "node --test tooling/quality/*.test.mjs",
    "quality:browser": "pnpm --filter @aifrontkit/core build && pnpm --filter @aifrontkit/react build && playwright test --config apps/lab/playwright.config.ts",
    "docs:browser": "playwright test --config apps/playground/playwright.config.ts",
    "check:browser": "pnpm quality:browser && pnpm docs:browser",
    "release:check": "pnpm check && pnpm packages:consumer && pnpm check:browser",
    "release:deprecate:legacy": "node scripts/deprecate-legacy-previews.mjs",
    "release:tags:preview": "node scripts/normalize-preview-tags.mjs",
    "lab:dev": "pnpm --filter @aifrontkit/lab dev",
    "check": "pnpm lint && pnpm contracts:validate && pnpm adoption:validate && pnpm adoption:test && pnpm registry:validate && pnpm registry:test && pnpm compatibility:test && pnpm quality:validate && pnpm quality:test && pnpm docs:validate && pnpm docs:test && pnpm performance:test && pnpm build && pnpm performance:check && pnpm packages:pack && pnpm registry:typecheck && pnpm typecheck && pnpm test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm release:check && changeset publish"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@changesets/cli": "^2.29.7",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
