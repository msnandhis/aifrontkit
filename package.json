{
  "name": "aifrontkit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "node scripts/check-boundaries.mjs",
    "boundaries": "pnpm lint",
    "registry:validate": "node scripts/validate-registry.mjs",
    "docs:validate": "node tooling/docs/validate-docs.mjs",
    "docs:test": "node --test tooling/docs/*.test.mjs",
    "check": "pnpm lint && pnpm registry:validate && pnpm docs:validate && pnpm docs:test && pnpm build && pnpm typecheck && pnpm test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
