{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "baseUrl": "..",
    "paths": {
      "@aifrontkit/core": ["packages/core/src/index.ts"],
      "@aifrontkit/core/*": ["packages/core/src/*/index.ts"],
      "@aifrontkit/react": ["packages/react/src/index.ts"],
      "@aifrontkit/react/*": ["packages/react/src/*/index.tsx"],
      "@aifrontkit/testing": ["packages/testing/src/index.ts"],
      "@aifrontkit/tokens": ["packages/tokens/src/index.ts"]
    },
    "types": ["react", "react-dom"]
  },
  "include": ["react/css/**/*.d.ts", "react/css/components/**/*.ts", "react/css/components/**/*.tsx", "react/css/examples/**/*.ts", "react/css/examples/**/*.tsx", "react/css/patterns/**/*.ts", "react/css/patterns/**/*.tsx", "react/tailwind/components/**/*.ts", "react/tailwind/components/**/*.tsx"]
}
