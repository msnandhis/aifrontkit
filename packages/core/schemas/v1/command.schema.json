{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aifrontkit.dev/schemas/commands/v1.json",
  "title": "AIFrontKit frontend command envelope v1",
  "type": "object",
  "required": ["schemaVersion", "id", "threadId", "timestamp", "type"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "threadId": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "number" },
    "type": {
      "enum": ["message.send", "message.retry", "connection.retry", "task.stop", "task.resume", "approval.resolve", "attachment.remove", "error.dismiss"]
    }
  },
  "additionalProperties": true
}
