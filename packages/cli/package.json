{
  "name": "aifrontkit",
  "version": "0.2.0-next.0",
  "description": "Install, inspect, and upgrade source-owned AIFrontKit UI",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msnandhis/openfrontkit.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/msnandhis/openfrontkit#readme",
  "bugs": {
    "url": "https://github.com/msnandhis/openfrontkit/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "aifrontkit": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./mcp": "./dist/mcp.js",
    "./provenance": "./dist/provenance.js",
    "./schema/config.json": "./dist/contracts/config.schema.json"
  },
  "scripts": {
    "prebuild": "node ../../scripts/clean-package-dist.mjs",
    "build": "tsc -p tsconfig.build.json && node scripts/prepare-bin.mjs",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
