{
  "name": "@aifrontkit/adapters",
  "version": "0.1.0",
  "description": "Provider and runtime adapters for AIFrontKit's canonical event model",
  "type": "module",
  "sideEffects": false,
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/msnandhis/aifrontkit.git", "directory": "packages/adapters" },
  "homepage": "https://github.com/msnandhis/aifrontkit#readme",
  "bugs": { "url": "https://github.com/msnandhis/aifrontkit/issues" },
  "keywords": ["ai", "ai-ui", "ai-sdk", "ag-ui", "langgraph", "adapter", "streaming", "typescript"],
  "engines": { "node": ">=22" },
  "publishConfig": { "access": "public", "provenance": true },
  "files": ["dist"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./ai-sdk": { "types": "./dist/ai-sdk/index.d.ts", "import": "./dist/ai-sdk/index.js" },
    "./ag-ui": { "types": "./dist/ag-ui/index.d.ts", "import": "./dist/ag-ui/index.js" },
    "./langgraph": { "types": "./dist/langgraph/index.d.ts", "import": "./dist/langgraph/index.js" },
    "./external-store": { "types": "./dist/external-store/index.d.ts", "import": "./dist/external-store/index.js" }
  },
  "scripts": {
    "prebuild": "node ../../scripts/clean-package-dist.mjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": { "@aifrontkit/core": "workspace:^" },
  "devDependencies": { "typescript": "^5.9.2", "vitest": "^3.2.4" }
}
