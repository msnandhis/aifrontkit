{
  "name": "@aifrontkit/tokens",
  "version": "0.1.0",
  "description": "Framework-neutral semantic design tokens for AIFrontKit",
  "type": "module",
  "sideEffects": ["./dist/tokens.css"],
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/msnandhis/openfrontkit.git", "directory": "packages/tokens" },
  "homepage": "https://github.com/msnandhis/openfrontkit#readme",
  "bugs": { "url": "https://github.com/msnandhis/openfrontkit/issues" },
  "engines": { "node": ">=22" },
  "publishConfig": { "access": "public", "provenance": true },
  "files": ["dist"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./css": "./dist/tokens.css"
  },
  "scripts": { "prebuild": "node ../../scripts/clean-package-dist.mjs", "build": "tsc -p tsconfig.build.json && node scripts/generate-css.mjs", "tokens:check": "node scripts/generate-css.mjs --check", "typecheck": "tsc -p tsconfig.json --noEmit", "test": "node scripts/generate-css.mjs --check && vitest run --passWithNoTests" },
  "devDependencies": { "typescript": "^5.9.2", "vitest": "^3.2.4" }
}
