{
  "name": "@aifrontkit/tokens",
  "version": "0.1.0",
  "description": "Framework-neutral semantic design tokens for AIFrontKit",
  "type": "module",
  "sideEffects": ["./dist/tokens.css"],
  "license": "Apache-2.0",
  "files": ["dist"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./css": "./dist/tokens.css"
  },
  "scripts": { "build": "tsc -p tsconfig.build.json && cp src/tokens.css dist/tokens.css", "typecheck": "tsc -p tsconfig.json --noEmit", "test": "vitest run --passWithNoTests" },
  "devDependencies": { "typescript": "^5.9.2", "vitest": "^3.2.4" }
}
