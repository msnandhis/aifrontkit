{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["playground"],
  "properties": {
    "playground": {
      "type": "object",
      "required": ["distDirectory", "manifest", "routeSourcePrefix", "minimumRouteChunks", "budgets"],
      "properties": {
        "distDirectory": { "type": "string", "minLength": 1 },
        "manifest": { "type": "string", "minLength": 1 },
        "routeSourcePrefix": { "type": "string", "minLength": 1 },
        "minimumRouteChunks": { "type": "integer", "minimum": 1 },
        "budgets": {
          "type": "object",
          "required": ["initialJavaScript", "initialStyles", "initialTotal", "routeChunk", "allRouteChunks", "onDemandChunk"],
          "additionalProperties": {
            "$ref": "#/$defs/limit"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "limit": {
      "type": "object",
      "properties": {
        "rawBytes": { "type": "integer", "minimum": 1 },
        "gzipBytes": { "type": "integer", "minimum": 1 }
      },
      "minProperties": 1,
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
